+static void
+cv_deadline(time_t seconds, long nanoseconds, struct timespec *ts)
+{
+	struct timespec now;
+
+	if (seconds < 0 || nanoseconds < 0 || nanoseconds >= NANOSEC)
+		_Exit(125);
+	gethrestime(&now);
+	if (nanoseconds >= NANOSEC - now.tv_nsec) {
+		if (seconds == LLONG_MAX)
+			_Exit(125);
+		seconds++;
+		nanoseconds -= NANOSEC - now.tv_nsec;
+	} else {
+		nanoseconds += now.tv_nsec;
+	}
+	if (seconds > LLONG_MAX - now.tv_sec)
+		_Exit(125);
+	ts->tv_sec = now.tv_sec + seconds;
+	ts->tv_nsec = nanoseconds;
+}
